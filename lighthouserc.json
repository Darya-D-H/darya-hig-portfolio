{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/",
        "http://localhost/projects/",
        "http://localhost/projects/invoice-tracker/",
        "http://localhost/projects/cli-toolkit/",
        "http://localhost/skills/",
        "http://localhost/experience/",
        "http://localhost/contact/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          { "minScore": 0.95, "aggregationMethod": "median-run" }
        ],
        "categories:accessibility": [
          "error",
          { "minScore": 1, "aggregationMethod": "median-run" }
        ],
        "categories:best-practices": [
          "error",
          { "minScore": 0.95, "aggregationMethod": "median-run" }
        ],
        "categories:seo": [
          "error",
          { "minScore": 0.95, "aggregationMethod": "median-run" }
        ],
        "largest-contentful-paint": [
          "error",
          { "maxNumericValue": 2000, "aggregationMethod": "median-run" }
        ],
        "cumulative-layout-shift": [
          "error",
          { "maxNumericValue": 0.05, "aggregationMethod": "median-run" }
        ],
        "total-blocking-time": [
          "error",
          { "maxNumericValue": 150, "aggregationMethod": "median-run" }
        ],
        "resource-summary:script:size": [
          "error",
          { "maxNumericValue": 15360, "aggregationMethod": "median-run" }
        ],
        "resource-summary:total:size": [
          "error",
          { "maxNumericValue": 512000, "aggregationMethod": "median-run" }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
