---
// The document shell every page renders inside. Phase 3.2 adds the skip
// link, the viewport-fit=cover viewport, meta and the #main landmark.
import { Font } from "astro:assets";
import "@/styles/global.css";

interface Props {
  /** The full document title. */
  title: string;
  /** Keeps the page out of search indexes, for the 404 and review pages. */
  noindex?: boolean;
}

const { title, noindex = false } = Astro.props;
---

<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.remove("no-js");
    </script>
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex" />}
    <Font cssVariable="--font-inter" />
  </head>
  <body>
    <slot />
  </body>
</html>
