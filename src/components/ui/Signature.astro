---
/**
 * Signature
 *
 * Darya's signature, "darya", in the Home hero below the headline. It
 * writes itself once on load, in one continuous cursive stroke: the
 * letters are filled shapes, revealed through a mask holding a single
 * thick pen stroke that never lifts. It runs through every letter in the
 * order a hand would, along the joins from one letter into the next, and
 * doubles back over its own line where a pen would (up the bowl of each
 * "a", back up the tail of the "y"). Drawn with stroke-dashoffset. CSS
 * only, so no client script. Under reduced motion, or wherever the
 * animation does not run, it is simply drawn.
 *
 * Inline, not an <img>, so it takes the text colour and is never an LCP
 * candidate. The letter shapes are "darya" set in Yellowtail (Astigmatic,
 * Apache License 2.0) and converted to paths, so no font is loaded; the pen
 * stroke was traced over them by hand. See docs/03-components.md §4.2a and
 * docs/04-motion.md §3.
 *
 * @example
 * <Signature class="mx-auto mt-6" />
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

