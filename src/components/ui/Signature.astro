<style>
  .signature {
    display: block;
    width: var(--size-signature);
    height: auto;
  }

  /*
   * The pen: one white stroke wide enough to cover each letter's thickest
   * part. Drawn in full by default, so the signature is complete with
   * reduced motion and wherever the animation does not run.
   */
  .pen {
    fill: none;
    stroke: white;
    stroke-width: 14;
    stroke-linecap: round;
    stroke-linejoin: round;
    /* A dash the length of the stroke, then a longer gap, so that before
       the pen starts nothing is drawn, not even a round cap. */
    stroke-dasharray: 1 2;
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .pen {
      animation: sign var(--duration-signature) var(--ease-in-out)
        var(--duration-base) both;
    }
  }

  @keyframes sign {
    from {
      stroke-dashoffset: 1.001;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
