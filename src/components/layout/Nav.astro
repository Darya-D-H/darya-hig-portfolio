---
/**
 * Nav
 *
 * Sticky, translucent, 44px bar with the wordmark and four links. Below
 * 735px the links give way to the MobileMenu trigger. It persists across
 * view transitions, so lib/menu.ts re-syncs aria-current after each one.
 * See docs/03-components.md §2.3.
 *
 * @example
 * <Nav />
 */
import Container from "@/components/layout/Container.astro";
import { navLinks, site } from "@/site.config";
import { currentState } from "@/lib/menu";

const path = Astro.url.pathname;
---

<header class="nav sticky top-0 z-sticky" transition:persist="site-nav">
  <nav aria-label="Main">
    <Container class="flex min-h-nav flex-wrap items-center justify-between">
      <a
        href="/"
        data-nav-link
        aria-current={currentState(path, "/")}
        class="flex min-h-touch items-center font-semibold text-body text-text-primary"
      >
        {site.name}
      </a>
      <ul class="nav-links hidden items-center gap-6 md:flex">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              data-nav-link
              aria-current={currentState(path, href)}
              class="nav-link flex min-h-touch items-center px-2 text-body-sm text-text-primary transition-colors hover:text-text-strong"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
      <button
        type="button"
        class="menu-trigger -mr-3 flex size-touch items-center justify-center text-text-primary md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-trigger
      >
        <span class="sr-only">Menu</span>
        <svg
          aria-hidden="true"
          class="menu-glyph"
          viewBox="0 0 18 18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        >
          <path d="M2 6h14M2 12h14"></path>
        </svg>
      </button>
    </Container>
  </nav>
</header>

<style>
  /*
   * Material on the control layer only (docs/02-design-tokens.md §7). The
   * prefixed property comes first and is not optional: Safari needs it.
   */
  .nav {
    padding-top: var(--inset-top);
    background-color: var(--color-nav-bg);
    -webkit-backdrop-filter: var(--blur-nav);
    backdrop-filter: var(--blur-nav);
  }

  @supports not (
    (backdrop-filter: blur(0)) or (-webkit-backdrop-filter: blur(0))
  ) {
    .nav {
      background-color: var(--color-nav-bg-fallback);
    }
  }

  /*
   * The hairline appears once content scrolls beneath the bar, with no
   * script. Browsers without scroll-driven animations show no hairline.
   */
  @supports (animation-timeline: scroll()) {
    .nav {
      animation: nav-edge linear both;
      animation-timeline: scroll(root);
      animation-range: 0 var(--space-2);
    }
  }

  @keyframes nav-edge {
    from {
      box-shadow: var(--shadow-none);
    }
    to {
      box-shadow: var(--shadow-nav);
    }
  }

  .menu-glyph {
    width: var(--space-5);
    height: var(--space-5);
  }

  [aria-current] {
    font-weight: var(--font-weight-semibold);
  }

  /* Without JavaScript the menu cannot open, so the links show instead. */
  :global(.no-js) .nav-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-2);
  }

  :global(.no-js) .menu-trigger {
    display: none;
  }
</style>
