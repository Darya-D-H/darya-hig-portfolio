---
/**
 * Footer
 *
 * Grey band with the four nav links in their own labelled nav, the social
 * links (from site.config, never hardcoded), BackToTop and a copyright line.
 * Persists across view transitions. See docs/03-components.md §2.6.
 *
 * @example
 * <Footer />
 */
import Container from "@/components/layout/Container.astro";
import BackToTop from "@/components/ui/BackToTop.astro";
import TextLink from "@/components/ui/TextLink.astro";
import { currentState } from "@/lib/menu";
import { navLinks, site } from "@/site.config";

const path = Astro.url.pathname;
const year = new Date().getFullYear();
---

<footer class="footer bg-surface-sunken pt-12" transition:persist="site-footer">
  <Container class="flex flex-col gap-8">
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              data-nav-link
              aria-current={currentState(path, href)}
              class="flex min-h-touch min-w-touch items-center text-body-sm text-text-secondary transition-colors hover:text-text-primary"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <ul class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Elsewhere">
      <li>
        <TextLink
          href={site.github}
          standalone
          external
          chevron
          class="text-body-sm"
        >
          GitHub
        </TextLink>
      </li>
      <li>
        <TextLink
          href={site.linkedin}
          standalone
          external
          chevron
          class="text-body-sm"
        >
          LinkedIn
        </TextLink>
      </li>
    </ul>

    <div class="flex flex-wrap items-center justify-between gap-4 border-t border-border-subtle pt-4">
      <p class="text-caption text-text-secondary">
        © {year} {site.name}
      </p>
      <BackToTop />
    </div>
  </Container>
</footer>

<style>
  .footer {
    padding-bottom: calc(var(--space-8) + var(--inset-bottom));
  }

  [aria-current] {
    color: var(--color-text-primary);
  }
</style>
