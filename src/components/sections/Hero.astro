---
/**
 * Hero
 *
 * Home's opening band: eyebrow, one enormous sentence (Darya's own line on
 * quality), her signature beneath it, and two actions, centred, with no
 * image. Nothing else here animates: it is above the fold and holds the
 * LCP element, and a fade-in on the first thing a visitor sees reads as
 * slowness. The signature is the one exception: it writes itself once on
 * load (see Signature). See docs/01-information-architecture.md §2.1.
 *
 * @example
 * <Hero headline="…" />
 */
import Section from "@/components/layout/Section.astro";
import Button from "@/components/ui/Button.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Signature from "@/components/ui/Signature.astro";
import { site } from "@/site.config";

interface Props {
  headline: string;
}

const { headline } = Astro.props;
---

<Section padding="hero" labelledBy="hero-title">
  <div class="mx-auto max-w-content-md text-center">
    <Eyebrow>{site.role}</Eyebrow>
    <h1 id="hero-title" class="mt-3 text-hero">
      {headline}
    </h1>
    <Signature class="mx-auto mt-6" />
    <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
      <Button href="/projects">View projects</Button>
      <Button variant="plain" href="/contact">
        Get in touch
      </Button>
    </div>
  </div>
</Section>
