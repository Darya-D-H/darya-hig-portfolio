---
/**
 * TimelineNode
 *
 * One node on an Experience timeline, a role or a qualification: an
 * <article> with its title as h3, the company or institution and the dates
 * in a <p> (each date in a <time> with its YYYY-MM value), then its points
 * as a list when it has any. Its dot is drawn by Timeline and is
 * invisible to assistive tech. See docs/03-components.md §4.2.
 *
 * @example
 * <TimelineNode entry={fromRole(role)} tone="onGrey" />
 */
import Card from "@/components/ui/Card.astro";
import { formatYearMonth as display } from "@/lib/dates";
import type { TimelineEntry } from "@/lib/timeline";

interface Props {
  entry: TimelineEntry;
  tone?: "onGrey" | "onWhite";
}

const { entry, tone = "onGrey" } = Astro.props;
---

<article>
  <Card tone={tone}>
    <h3 class="text-card-title">{entry.title}</h3>
    <p class="mt-1 text-body-sm text-text-secondary">
      {entry.organisationUrl ? (
        <a href={entry.organisationUrl} class="text-link underline">
          {entry.organisation}
        </a>
      ) : (
        entry.organisation
      )}
      <span aria-hidden="true"> · </span>
      <time datetime={entry.startDate}>{display(entry.startDate)}</time>
      {" — "}
      {entry.endDate ? (
        <time datetime={entry.endDate}>{display(entry.endDate)}</time>
      ) : (
        "Present"
      )}
      {entry.location && (
        <>
          <span aria-hidden="true"> · </span>
          {entry.location}
        </>
      )}
    </p>
    {entry.points.length > 0 && (
      <ul class="mt-4 flex list-disc flex-col gap-2 pl-5 text-body">
        {entry.points.map((point) => (
          <li>{point}</li>
        ))}
      </ul>
    )}
  </Card>
</article>
