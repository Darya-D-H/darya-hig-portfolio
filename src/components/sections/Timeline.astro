---
/**
 * Timeline
 *
 * One of the Experience page's two timelines, roles or education, as an
 * ordered list, newest first. Each collection is mapped to a TimelineEntry
 * first (src/lib/timeline.ts), so this never knows which it shows. One vertical
 * hairline on the <ol> and a dot on each <li>, both CSS pseudo-elements and
 * so invisible to assistive tech. The same component at every width: below
 * 735px the line moves in to 8px and the cards take the full width. Not a
 * left/right zigzag. See docs/03-components.md §4.2 and
 * docs/01-information-architecture.md §6.
 *
 * @example
 * <Timeline id="roles" heading="Roles" headingHidden
 *   entries={roles.map(({ data }) => fromRole(data))} />
 */
import Section from "@/components/layout/Section.astro";
import TimelineNode from "@/components/sections/TimelineNode.astro";
import Reveal from "@/components/ui/Reveal.astro";
import { staggerDelay } from "@/lib/reveal";
import { byOrder, type TimelineEntry } from "@/lib/timeline";

interface Props {
  /** Prefix for the id of the heading that names the band. */
  id: string;
  heading: string;
  /** Keeps the h2 for the outline but hides it visually. */
  headingHidden?: boolean;
  tone?: "grey" | "white";
  entries: TimelineEntry[];
}

const { id, heading, headingHidden = false, tone = "grey" } = Astro.props;
const entries = byOrder(Astro.props.entries);
const headingId = `${id}-heading`;
---

{entries.length > 0 && (
  <Section tone={tone} labelledBy={headingId}>
    {headingHidden ? (
      <h2 id={headingId} class="sr-only">
        {heading}
      </h2>
    ) : (
      <Reveal>
        <h2 id={headingId} class="text-headline">
          {heading}
        </h2>
      </Reveal>
    )}
    <ol
      class:list={["timeline flex flex-col gap-8", !headingHidden && "mt-12"]}
    >
      {entries.map((entry, index) => (
        <li class="node">
          <Reveal delay={staggerDelay(index)}>
            <TimelineNode
              entry={entry}
              tone={tone === "grey" ? "onGrey" : "onWhite"}
            />
          </Reveal>
        </li>
      ))}
    </ol>
  </Section>
)}

<style>
  /* Lets @variant read the breakpoint tokens, so no width is repeated. */
  @reference "@/styles/global.css";

  /*
   * Mobile first: the line a small step in, small dots, cards a short way
   * off the line. From md: the line at the column edge, full-size dots,
   * cards further off it. Values per docs/03-components.md §4.2.
   */
  .timeline {
    --line-x: var(--space-2);
    --dot: var(--size-timeline-dot-sm);
    --offset: var(--space-7);
    position: relative;
    padding-inline-start: calc(var(--line-x) + var(--offset));

    @variant md {
      --line-x: var(--spacing-0);
      --dot: var(--size-timeline-dot);
      --offset: var(--space-12);
    }
  }

  .timeline::before {
    content: "";
    position: absolute;
    inset-block: 0;
    inset-inline-start: var(--line-x);
    width: var(--size-hairline);
    background-color: var(--color-border-subtle);
  }

  .node {
    position: relative;
  }

  /* Level with the role title: the card's padding plus half a line. */
  .node::before {
    content: "";
    position: absolute;
    top: calc(var(--space-6) + 0.6em);
    inset-inline-start: calc(
      -1 * var(--offset) - var(--dot) / 2 + var(--size-hairline) / 2
    );
    width: var(--dot);
    height: var(--dot);
    border-radius: var(--radius-pill);
    background-color: var(--color-text-secondary);

    /* The card's padding grows at lg, and so does the title. */
    @variant lg {
      top: calc(var(--space-8) + 0.75em);
    }
  }
</style>
